# TkSwarm PHP API（Web 控制台登录；本机内置 executor 领任务也走这套）
TKSWARM_API_BASE=http://127.0.0.1:8080/api
# 可选：服务账号 Token（不设则用控制台最近登录会话）
# TKSWARM_API_TOKEN=

# 任务执行核心已内置在 src/executor（坐席/拓客等），无需旁路 tkswarm-node
# 服务器浏览器任务队列（本进程，最多 3 路；设 0 可关）
# TKSWARM_SERVER_BROWSER_AUTO=1
# TKSWARM_SERVER_BROWSER_CONCURRENCY=3

# Bit 兼容 API 监听（默认对内网开放，生产请用防火墙限制）
TKSWARM_BROWSER_HOST=0.0.0.0
TKSWARM_BROWSER_PORT=54345

# 数据目录（环境 profile / Cookie）
# TKSWARM_BROWSER_DATA=/var/lib/tkswarm-linuxbrowse

# 内核：强制 Electron（EL），与桌面自研同核才能共用环境包；禁止 chrome/chromium
TKSWARM_BROWSER_ENGINE=electron

# 每账号最大环境数（仅 TKSWARM_STRICT_ENV_OWNER=1 时按人计；默认共用按整机上限）
TKSWARM_BROWSER_MAX_ENVS=300
# 共用模式整机环境上限（默认约 max(1000, MAX_ENVS*20)）
# TKSWARM_BROWSER_MAX_ENVS_TOTAL=5000

# 默认环境共用（不按管理用户隔离）。真·多租户才设 1
# TKSWARM_STRICT_ENV_OWNER=0

# 同时运行 EL 窗口上限（客服长驻建议 20～60，按内存调）
TKSWARM_BROWSER_MAX_CONCURRENT=40

# 有头模式是否自动起 Xvfb（无物理显示器的服务器保持 1）
TKSWARM_BROWSER_XVFB=1

# Docker / root 下 Electron 需要 --no-sandbox
TKSWARM_CHROME_NO_SANDBOX=1

# VNC 密码（监听 0.0.0.0 时必填，否则拒绝启动无密码 VNC）
# TKSWARM_VNC_PASSWORD=change-me
# TKSWARM_VNC_ALLOW_NOPW=1

# 鉴权：默认强制 Bearer；本地调试可允许无 Token 兜底
# TKSWARM_ALLOW_ANON=1

# Token 与 PHP 同步校验
# TKSWARM_TOKEN_VALIDATE_TTL_MS=60000
# TKSWARM_TOKEN_VALIDATE_INTERVAL_MS=120000
# TKSWARM_GC_INTERVAL_MS=60000

# 窗口无 open/detail 等 API 活动多久后自动 close（ms）；0=关闭。坐席长挂建议 0；批任务可设 3600000
# TKSWARM_SESSION_STALE_MS=0

# 多机标识（写入 health.hostId）；不设则用主机名
# TKSWARM_HOST_ID=lb-seat-01
# 环境粘滞到首次打开的主机（换机请导出导入或 /browser/host/rebind）
# TKSWARM_STICKY_HOST=1

# 审计 JSONL（默认开；0=关）
# TKSWARM_AUDIT=1
# TKSWARM_AUDIT_MAX_BYTES=20971520

# 有头短时录屏默认时长（秒，上限 600）；需 apt install ffmpeg
# TKSWARM_RECORD_MAX_SEC=120
